# Copy to .env and fill in values

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.pythonanywhere.com,.up.railway.app,.run.app

# SQLite (local default) — leave DATABASE_URL empty
# DATABASE_URL=

# PostgreSQL (Railway / Cloud Run / production)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Optional Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
